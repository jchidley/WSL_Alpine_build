#!/usr/bin/env bash
# ABOUTME: Main Alpine WSL management script with subcommands
# ABOUTME: Single entry point for building, managing, and testing Alpine WSL distributions

set -euo pipefail

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source libraries
# shellcheck source=src/lib/common.sh
source "${SCRIPT_DIR}/src/lib/common.sh"
# shellcheck source=src/lib/minirootfs.sh
source "${SCRIPT_DIR}/src/lib/minirootfs.sh"
# shellcheck source=src/lib/wsl-operations.sh
source "${SCRIPT_DIR}/src/lib/wsl-operations.sh"
# shellcheck source=src/lib/package.sh
source "${SCRIPT_DIR}/src/lib/package.sh"

# Version
readonly VERSION="2.0.0"

# Default values
DEFAULT_DISTRO_NAME="alpine-wsl"
DEFAULT_MODULES="base,podman,pi-agent,development"
DEFAULT_BUILD_DIR="/tmp/alpine-wsl-build"

# Print usage
print_usage() {
    cat << EOF
Alpine WSL Management Tool v${VERSION}

Usage: $(basename "$0") <command> [options]

Commands:
    build       Build a new Alpine WSL distribution
    install     Import a distribution into WSL
    up          Build/import a disposable workspace target
    shell       Open a shell in a workspace target
    exec        Execute a command in a workspace target
    down        Stop/remove a workspace target
    gc          Cleanup disposable workspaces
    reset       Remove a WSL distribution
    test        Run tests
    module      Manage distribution modules
    list        List WSL distributions
    help        Show this help message

Options:
    --help, -h      Show help for a specific command
    --version, -v   Show version information

Examples:
    $(basename "$0") build                    # Build with default settings
    $(basename "$0") build --modules all      # Build with all modules
    $(basename "$0") up --target dev          # Build/import disposable target
    $(basename "$0") shell dev                # Open shell in target
    $(basename "$0") down dev --purge         # Remove target distro
    $(basename "$0") module list              # List available modules
    $(basename "$0") test                     # Run all tests

For command-specific help, use: $(basename "$0") <command> --help
EOF
}

# Print build command usage
print_build_usage() {
    cat << EOF
Build Alpine WSL Distribution

Usage: $(basename "$0") build [options]

Options:
    --name NAME             Distribution name (default: $DEFAULT_DISTRO_NAME)
    --modules MODULES       Comma-separated list of modules to install
                           Available: base, podman, pi-agent, development
                           Use 'all' to install all modules
    --no-import          Build only, don't import to WSL
    --help, -h           Show this help message

Examples:
    $(basename "$0") build
    $(basename "$0") build --name my-alpine --modules base,podman,pi-agent
    $(basename "$0") build --modules all --no-import
EOF
}

# Build command
cmd_build() {
    local distro_name="$DEFAULT_DISTRO_NAME"
    local modules="$DEFAULT_MODULES"
    local alpine_version="$ALPINE_VERSION"
    local arch="$ALPINE_ARCH"
    local output_file="alpine-wsl.tar.gz"
    local build_dir="$DEFAULT_BUILD_DIR"
    local no_import=false
    
    # Parse build options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                distro_name="$2"
                shift 2
                ;;
            --modules)
                modules="$2"
                shift 2
                ;;
            --no-import)
                no_import=true
                shift
                ;;
            --help|-h)
                print_build_usage
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                print_build_usage
                return 1
                ;;
        esac
    done
    
    # Validate inputs
    if ! validate_distribution_name "$distro_name"; then
        return 1
    fi

    # Fail fast on Windows interop problems when import is requested
    if [[ "$no_import" == "false" ]]; then
        if ! find_wsl_exe; then
            return 1
        fi
    fi
    
    # Check prerequisites
    log_info "Checking prerequisites..."
    if ! check_dependencies wget tar gzip sha256sum fakeroot; then
        return 1
    fi
    
    # Setup build directory
    log_info "Setting up build environment..."
    rm -rf "$build_dir"
    mkdir -p "$build_dir"
    
    local rootfs_dir="$build_dir/rootfs"
    local work_dir="$build_dir/work"
    
    # Prepare minirootfs
    if ! prepare_minirootfs "$alpine_version" "$arch" "$rootfs_dir" "$work_dir"; then
        log_error "Failed to prepare minirootfs"
        return 1
    fi
    
    # Configure WSL
    create_wsl_conf "$rootfs_dir" "wsluser" "false"
    create_wsl_distribution_conf "$rootfs_dir" "$distro_name"
    
    # Apply modules
    log_info "Applying modules: $modules"
    if [[ "$modules" == "all" ]]; then
        modules="base,podman,pi-agent,development"
    fi
    
    # Process each module
    IFS=',' read -ra module_array <<< "$modules"
    for module in "${module_array[@]}"; do
        module=$(echo "$module" | tr -d ' ')
        if ! apply_module "$rootfs_dir" "$module"; then
            log_error "Failed to apply module: $module"
            return 1
        fi
    done
    
    # Create OOBE script
    create_oobe_script "$rootfs_dir" "$distro_name"
    
    # Package distribution
    local package_path="$build_dir/$output_file"
    if ! package_rootfs "$rootfs_dir" "$package_path"; then
        log_error "Failed to package distribution"
        return 1
    fi
    
    # Create .wsl file
    create_wsl_file "$package_path"
    
    # Import to WSL if requested
    if [[ "$no_import" == "false" ]]; then
        log_info "Importing distribution to WSL..."
        if distribution_exists "$distro_name"; then
            log_warning "Distribution '$distro_name' already exists"
            read -p "Replace it? (y/N): " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                unregister_distribution "$distro_name"
            else
                log_info "Skipping import"
                no_import=true
            fi
        fi
        
        if [[ "$no_import" == "false" ]]; then
            import_distribution "$distro_name" "$package_path"
        fi
    fi
    
    # Summary
    log_success "Build complete!"
    log_info "Distribution files:"
    log_info "  - $package_path"
    log_info "  - ${package_path%.tar.gz}.wsl"
    
    if [[ "$no_import" == "false" ]]; then
        log_info ""
        log_info "To start the distribution:"
        log_info "  wsl.exe -d $distro_name"
    fi
}

# Install command (import existing archive)
cmd_install() {
    local distro_name="$DEFAULT_DISTRO_NAME"
    local archive=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                distro_name="$2"
                shift 2
                ;;
            --help|-h)
                cat << EOF
Import Existing Alpine WSL Archive

Usage: $(basename "$0") install [--name <distro>] <archive.tar.gz>

Examples:
    $(basename "$0") install alpine-wsl.tar.gz
    $(basename "$0") install --name my-alpine alpine-wsl.tar.gz
EOF
                return 0
                ;;
            *)
                if [[ -z "$archive" ]]; then
                    archive="$1"
                    shift
                else
                    log_error "Unknown option: $1"
                    return 1
                fi
                ;;
        esac
    done

    [[ -n "$archive" ]] || { log_error "Archive file required"; return 1; }
    import_distribution "$distro_name" "$archive"
}

# Apply a module to the rootfs
apply_module() {
    local rootfs_dir="$1"
    local module_name="$2"
    local module_dir="${SCRIPT_DIR}/src/modules/${module_name}"
    
    if [[ ! -d "$module_dir" ]]; then
        log_error "Module not found: $module_name"
        return 1
    fi
    
    log_progress "Applying module: $module_name"
    
    # Run module installation script if it exists
    if [[ -f "$module_dir/install.sh" ]]; then
        # shellcheck source=/dev/null
        if ROOTFS_DIR="$rootfs_dir" bash "$module_dir/install.sh"; then
            log_success "Module $module_name applied successfully"
        else
            log_error "Module $module_name installation failed"
            return 1
        fi
    else
        log_warning "Module $module_name has no install script"
    fi
    
    return 0
}

# Create OOBE script
create_oobe_script() {
    local rootfs_dir="$1"
    local distro_name="$2"
    
    log_progress "Creating first-boot setup script..."
    
    cat > "$rootfs_dir/etc/oobe.sh" << 'EOF'
#!/bin/sh
# Alpine WSL First-Boot Setup

# Exit if already run
if [ -f /etc/oobe.done ]; then
    exit 0
fi

echo "╔══════════════════════════════════════════╗"
echo "║   Welcome to Alpine Linux for WSL!       ║"
echo "╚══════════════════════════════════════════╝"
echo ""
echo "Running first-time setup..."

# Run all OOBE scripts in order
if [ -d /etc/oobe.d ]; then
    for script in /etc/oobe.d/*.sh; do
        if [ -x "$script" ]; then
            echo ""
            echo "→ Running $(basename "$script")..."
            if "$script"; then
                echo "✓ $(basename "$script") completed"
            else
                echo "✗ $(basename "$script") failed" >&2
                exit 1
            fi
        fi
    done
fi

# Mark as complete
touch /etc/oobe.done

echo ""
echo "✓ First-time setup complete!"
echo ""
echo "The distribution will now restart with the default user."
echo "Please close this window and run:"
echo "  wsl.exe --terminate $WSL_DISTRO_NAME"
echo "  wsl.exe -d $WSL_DISTRO_NAME"
echo ""
EOF
    
    chmod +x "$rootfs_dir/etc/oobe.sh"
}

# Reset command
cmd_reset() {
    local distro_name=""
    local preserve_data=false
    
    # Parse reset options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --preserve)
                preserve_data=true
                shift
                ;;
            --help|-h)
                cat << EOF
Reset (Remove) Alpine WSL Distribution

Usage: $(basename "$0") reset <name> [options]

Options:
    --preserve      Export distribution data before removal
    --help, -h      Show this help message

Examples:
    $(basename "$0") reset alpine-wsl
    $(basename "$0") reset my-alpine --preserve
EOF
                return 0
                ;;
            *)
                if [[ -z "$distro_name" ]]; then
                    distro_name="$1"
                    shift
                else
                    log_error "Unknown option: $1"
                    return 1
                fi
                ;;
        esac
    done
    
    if [[ -z "$distro_name" ]]; then
        log_error "Distribution name required"
        return 1
    fi
    
    # Check sudo access if needed
    if [[ "$EUID" -ne 0 ]]; then
        log_info "Some cleanup operations may require sudo access"
    fi
    
    # Find WSL executable
    if ! find_wsl_exe; then
        return 1
    fi
    
    # Unregister distribution
    unregister_distribution "$distro_name" "$preserve_data"
}

# Test command
cmd_test() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                cat << EOF
Run Tests

Usage: $(basename "$0") test

Runs the standard unit + integration suite.
EOF
                return 0
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done

    log_info "Running standard test suite"

    if ! command_exists bats; then
        log_error "BATS test framework not found"
        log_info "Install with: sudo apt-get install bats"
        return 1
    fi

    bats "${SCRIPT_DIR}"/tests/unit/*.bats \
         "${SCRIPT_DIR}"/tests/integration/test_build_workflow.bats \
         "${SCRIPT_DIR}"/tests/integration/test_modular_build.bats \
         "${SCRIPT_DIR}"/tests/integration/test_build_validation.bats
}

# Module command
cmd_module() {
    local subcmd="${1:-list}"
    shift || true
    
    case "$subcmd" in
        list)
            log_info "Available modules:"
            for module_dir in "${SCRIPT_DIR}"/src/modules/*/; do
                if [[ -d "$module_dir" ]]; then
                    local module_name
                    module_name=$(basename "$module_dir")
                    local description="No description"
                    
                    # Read metadata if available
                    if [[ -f "$module_dir/metadata.yaml" ]]; then
                        description=$(grep "^description:" "$module_dir/metadata.yaml" | cut -d: -f2- | sed 's/^ *//')
                    fi
                    
                    printf "  %-15s %s\n" "$module_name" "$description"
                fi
            done
            ;;
        
        info)
            local module_name="$1"
            if [[ -z "$module_name" ]]; then
                log_error "Module name required"
                return 1
            fi
            
            local module_dir="${SCRIPT_DIR}/src/modules/${module_name}"
            if [[ ! -d "$module_dir" ]]; then
                log_error "Module not found: $module_name"
                return 1
            fi
            
            log_info "Module: $module_name"
            if [[ -f "$module_dir/metadata.yaml" ]]; then
                cat "$module_dir/metadata.yaml"
            else
                log_warning "No metadata available"
            fi
            
            if [[ -f "$module_dir/README.md" ]]; then
                echo ""
                cat "$module_dir/README.md"
            fi
            ;;
        
        --help|-h|help)
            cat << EOF
Manage Distribution Modules

Usage: $(basename "$0") module <subcommand> [options]

Subcommands:
    list        List available modules
    info        Show information about a module

Examples:
    $(basename "$0") module list
    $(basename "$0") module info podman
EOF
            ;;
        
        *)
            log_error "Unknown module subcommand: $subcmd"
            return 1
            ;;
    esac
}

# List command
cmd_list() {
    log_info "WSL Distributions:"
    
    # Find WSL executable
    if ! find_wsl_exe; then
        return 1
    fi
    
    # Use our detailed listing function
    list_distributions_detailed
}

# Workspace target state
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wsl-alpine"

resolve_target_file() {
    local target_ref="$1"
    if [[ -f "$target_ref" ]]; then
        echo "$target_ref"
    elif [[ -f "${SCRIPT_DIR}/targets/${target_ref}.yaml" ]]; then
        echo "${SCRIPT_DIR}/targets/${target_ref}.yaml"
    else
        return 1
    fi
}

load_target() {
    local target_file="$1"
    TARGET_NAME=$(grep -E '^name:' "$target_file" | head -1 | cut -d: -f2- | xargs)
    TARGET_ALPINE=$(grep -E '^alpine:' "$target_file" | head -1 | cut -d: -f2- | tr -d '"' | xargs)
    TARGET_MODULES=$(grep -E '^modules:' "$target_file" | head -1 | cut -d: -f2- | tr -d '[]" ')
    TARGET_DISPOSABLE=$(grep -E '^disposable:' "$target_file" | head -1 | cut -d: -f2- | xargs)

    TARGET_NAME="${TARGET_NAME:-$(basename "$target_file" .yaml)}"
    TARGET_ALPINE="${TARGET_ALPINE:-$ALPINE_VERSION}"
    TARGET_MODULES="${TARGET_MODULES:-base,podman,pi-agent,development}"
    TARGET_DISPOSABLE="${TARGET_DISPOSABLE:-true}"
    TARGET_DISTRO="wslw-${TARGET_NAME}"
    TARGET_HASH=$(sha256sum "$target_file" | awk '{print $1}')
}

target_state_file() {
    local target_name="$1"
    echo "${STATE_DIR}/${target_name}.state"
}

write_target_state() {
    local target_name="$1"
    local target_file="$2"
    mkdir -p "$STATE_DIR"
    cat > "$(target_state_file "$target_name")" << EOF
TARGET_NAME=$TARGET_NAME
TARGET_DISTRO=$TARGET_DISTRO
TARGET_FILE=$target_file
TARGET_HASH=$TARGET_HASH
UPDATED_AT=$(date +%s)
EOF
}

read_target_state() {
    local target_name="$1"
    local state_file
    state_file=$(target_state_file "$target_name")
    [[ -f "$state_file" ]] || return 1
    # shellcheck source=/dev/null
    source "$state_file"
}

cmd_up() {
    local target_ref=""
    local rebuild=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                target_ref="$2"; shift 2 ;;
            --rebuild)
                rebuild=true; shift ;;
            --help|-h)
                echo "Usage: $(basename "$0") up --target <name|file> [--rebuild]"; return 0 ;;
            *)
                [[ -z "$target_ref" ]] && target_ref="$1" && shift || { log_error "Unknown option: $1"; return 1; }
                ;;
        esac
    done
    [[ -n "$target_ref" ]] || { log_error "Target required"; return 1; }

    local target_file
    target_file=$(resolve_target_file "$target_ref") || { log_error "Target not found: $target_ref"; return 1; }
    load_target "$target_file"
    find_wsl_exe || return 1

    local prev_hash=""
    if read_target_state "$TARGET_NAME"; then
        prev_hash="${TARGET_HASH:-}"
    fi

    load_target "$target_file"
    if distribution_exists "$TARGET_DISTRO" && [[ "$rebuild" == "false" ]] && [[ -n "$prev_hash" ]] && [[ "$prev_hash" == "$TARGET_HASH" ]]; then
        log_info "Target up-to-date: $TARGET_NAME ($TARGET_DISTRO)"
        return 0
    fi

    if distribution_exists "$TARGET_DISTRO"; then
        log_info "Rebuilding existing target distro: $TARGET_DISTRO"
        unregister_distribution "$TARGET_DISTRO" || return 1
    fi

    ALPINE_VERSION="$TARGET_ALPINE" cmd_build --name "$TARGET_DISTRO" --modules "$TARGET_MODULES" || return 1
    write_target_state "$TARGET_NAME" "$target_file"
}

cmd_shell() {
    local target_name="${1:-}"
    [[ -n "$target_name" ]] || { log_error "Target required"; return 1; }
    read_target_state "$target_name" || { log_error "Unknown target: $target_name"; return 1; }
    find_wsl_exe || return 1
    exec "$WSL_EXE" --cd / -d "$TARGET_DISTRO"
}

cmd_exec_target() {
    local target_name="${1:-}"
    shift || true
    [[ -n "$target_name" ]] || { log_error "Target required"; return 1; }
    [[ "${1:-}" == "--" ]] && shift
    [[ $# -gt 0 ]] || { log_error "Command required"; return 1; }
    read_target_state "$target_name" || { log_error "Unknown target: $target_name"; return 1; }
    run_in_distribution "$TARGET_DISTRO" "$@"
}

cmd_down() {
    local target_name="${1:-}"
    local purge=false
    [[ -n "$target_name" ]] || { log_error "Target required"; return 1; }
    shift || true
    [[ "${1:-}" == "--purge" ]] && purge=true

    read_target_state "$target_name" || { log_error "Unknown target: $target_name"; return 1; }
    find_wsl_exe || return 1
    "$WSL_EXE" --terminate "$TARGET_DISTRO" 2>/dev/null || true

    if [[ "$purge" == "true" ]]; then
        unregister_distribution "$TARGET_DISTRO" || true
        rm -f "$(target_state_file "$target_name")"
    fi
}

cmd_gc() {
    local now cutoff_days=7
    now=$(date +%s)
    mkdir -p "$STATE_DIR"
    for sf in "$STATE_DIR"/*.state; do
        [[ -f "$sf" ]] || continue
        # shellcheck source=/dev/null
        source "$sf"
        local age_days=$(( (now - UPDATED_AT) / 86400 ))
        if [[ "$age_days" -ge "$cutoff_days" ]]; then
            log_info "GC purging $TARGET_NAME ($TARGET_DISTRO), age ${age_days}d"
            unregister_distribution "$TARGET_DISTRO" || true
            rm -f "$sf"
        fi
    done
}

# Main command dispatcher
main() {
    # Global options
    while [[ $# -gt 0 ]] && [[ "$1" =~ ^-- ]]; do
        case "$1" in
            --version|-v)
                echo "Alpine WSL Management Tool v${VERSION}"
                return 0
                ;;
            --help|-h)
                print_usage
                return 0
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done
    
    # Setup error handling
    setup_error_handling
    
    # Get command
    local cmd="${1:-help}"
    shift || true
    
    # Dispatch command
    case "$cmd" in
        build)
            cmd_build "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        up)
            cmd_up "$@"
            ;;
        shell)
            cmd_shell "$@"
            ;;
        exec)
            cmd_exec_target "$@"
            ;;
        down)
            cmd_down "$@"
            ;;
        gc)
            cmd_gc "$@"
            ;;
        reset)
            cmd_reset "$@"
            ;;
        test)
            cmd_test "$@"
            ;;
        module)
            cmd_module "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        help)
            print_usage
            ;;
        *)
            log_error "Unknown command: $cmd"
            print_usage
            return 1
            ;;
    esac
}

# Run main function
main "$@"