# WSL Alpine Build Configuration Example
# Copy this file to .env and customize as needed

# Basic Configuration (Required)
SUDO=sudo
WSL_DISTRIBUTION_NAME=alp2
CHROOT_DIR="/tmp/$WSL_DISTRIBUTION_NAME"

# Alpine Configuration
# Use specific version (v3.18, v3.19) or 'edge' for latest
ALPINE_VERSION=edge

# Package Selection
# Editors and syntax highlighting
EDITOR_PACKAGES="helix tree-sitter-bash tree-sitter-regex tree-sitter-json tree-sitter-toml tree-sitter-ini tree-sitter-comment"

# Terminal utilities
TOOL_PACKAGES="fd bat zoxide fzf"

# Additional packages (space-separated)
EXTRA_PACKAGES=""

# Build Options
# Compression level: --fast, --best, or -1 through -9
COMPRESSION_LEVEL="--fast"

# Output location for the WSL distribution file
WSL_INSTALL_PATH="$HOME/alpine.wsl.gz"

# Advanced Options
# Enable systemd support (experimental)
SYSTEMD_ENABLED=false

# User Configuration (for future use)
# USER_NAME=alpine
# USER_PASSWORD=""

# Package Presets (for future use)
# PACKAGE_PRESET=standard  # Options: minimal, standard, development, server