# WSL Alpine Build Configuration
# Copy this file to '.env' and adjust values as needed

# Basic Configuration
# ------------------

# Command to use for elevated privileges 
SUDO=sudo

# Name of the WSL distribution
WSL_DISTRIBUTION_NAME=alp2

# Temporary directory for building the chroot
CHROOT_DIR="/tmp/${WSL_DISTRIBUTION_NAME}"

# Alpine Version Configuration
# ---------------------------
# Uncomment to specify a particular Alpine version
# Options: 'edge', 'latest', 'v3.19', 'v3.18', 'v3.17', etc.
# ALPINE_VERSION=v3.18

# Package Configuration
# -------------------
# Uncomment and modify to customize packages installed during build

# Text editor and utilities
# EDITOR_PACKAGES="helix tree-sitter-bash tree-sitter-json tree-sitter-toml"

# Command-line tools
# TOOL_PACKAGES="fd bat zoxide fzf"

# Additional packages to install at build time
# EXTRA_PACKAGES="vim git curl htop"

# Advanced Configuration
# --------------------
# COMPRESSION_LEVEL=--fast  # Options: --fast, --best, -1 through -9

# WSL-specific Configuration
# -------------------------
# SYSTEMD_ENABLED=false  # Set to true to enable systemd in WSL

# Installation Path
# ---------------
# Override the default path for the WSL distribution file
# WSL_INSTALL_PATH=~/alpine.wsl.gz