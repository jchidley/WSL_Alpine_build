# WSL Alpine Build Configuration
# Copy this file to '.env' and adjust values as needed

# Basic Configuration
# ------------------

# Command to use for elevated privileges 
SUDO=sudo

# Name of the WSL distribution
WSL_DISTRIBUTION_NAME=alp2

# Temporary directory for building the chroot
CHROOT_DIR="/tmp/${WSL_DISTRIBUTION_NAME}"

# Alpine Version Configuration
# ---------------------------
# Uncomment to specify a particular Alpine version
# Options: 'edge', 'latest', 'v3.19', 'v3.18', 'v3.17', etc.
# ALPINE_VERSION=v3.18

# Package Configuration
# -------------------
# Uncomment and modify to customize packages installed during build

# Package preset (automatically configures groups of packages)
# Options: 'standard', 'minimal', 'development', 'server'
# PACKAGE_PRESET=standard

# Text editor and utilities
# EDITOR_PACKAGES="helix tree-sitter-bash tree-sitter-json tree-sitter-toml"

# Command-line tools
# TOOL_PACKAGES="fd bat zoxide fzf"

# Additional packages to install at build time
# EXTRA_PACKAGES="vim git curl htop"

# Development environment focus (sets up language-specific packages)
# Options: 'python', 'rust', 'go', 'node'
# DEV_ENVIRONMENT=python

# User Configuration
# ----------------
# Create a regular user account (leave empty to use root only)
# USER_NAME=alpine
# USER_PASSWORD=      # Empty for interactive prompt during first boot

# Customization Options
# -------------------
# CUSTOM_ICON_PATH=/path/to/custom-icon.ico  # Custom WSL distribution icon

# Windows Terminal integration
# CONFIGURE_WINDOWS_TERMINAL=true  # Configure Windows Terminal profile

# Shared directory configuration
# SHARED_WINDOWS_DIRS=Documents,Pictures  # Windows directories to share

# Network Configuration
# -------------------
# DNS_SERVERS=1.1.1.1,8.8.8.8  # Custom DNS servers

# Build Options
# -----------
# COMPRESSION_LEVEL=--fast  # Options: --fast, --best, -1 through -9

# WSL-specific Configuration
# -------------------------
# SYSTEMD_ENABLED=false  # Set to true to enable systemd in WSL

# Post-installation customization
# POST_INSTALL_SCRIPT=/path/to/custom-script.sh  # Run after installation

# Installation Path
# ---------------
# Override the default path for the WSL distribution file
# WSL_INSTALL_PATH=~/alpine.wsl.gz